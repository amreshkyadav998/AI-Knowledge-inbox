# ---------------------------------------------------------------------------
# AI Knowledge Inbox - server configuration
# Copy this file to `.env` and fill in what you need.
# The app boots and works with NO keys at all (AI_PROVIDER=local).
# ---------------------------------------------------------------------------

# HTTP
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Storage. Relative paths resolve against the server package root.
DATABASE_PATH=./data/inbox.sqlite

# Logging: debug | info | warn | error
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# AI provider: gemini | openai | local
#   gemini -> Google AI Studio (free tier).  https://aistudio.google.com/apikey
#   openai -> https://platform.openai.com/api-keys
#   local  -> no network, no key. Deterministic hashed embeddings + extractive
#             answers. Retrieval quality is much lower; it exists so the app is
#             always runnable and testable offline.
# ---------------------------------------------------------------------------
AI_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Matryoshka truncation: 768 keeps almost all retrieval quality at a quarter of
# the storage of the native 3072. Changing it invalidates existing chunks.
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_CHAT_MODEL=gemini-3.6-flash

OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# RAG tuning
# ---------------------------------------------------------------------------
CHUNK_TARGET_CHARS=900
CHUNK_OVERLAP_CHARS=150
RETRIEVAL_TOP_K=5
# Cosine floor below which a chunk counts as irrelevant. Leave unset to use the
# floor the active embedding model declares (gemini 0.60, openai 0.35,
# local 0.20) - these are model-specific and not interchangeable.
# RETRIEVAL_MIN_SCORE=0.6

# ---------------------------------------------------------------------------
# URL ingestion guardrails
# ---------------------------------------------------------------------------
FETCH_TIMEOUT_MS=15000
FETCH_MAX_BYTES=2000000
# Allow fetching private/loopback addresses. Keep 'false' outside of tests:
# 'true' turns the ingest endpoint into an SSRF primitive.
ALLOW_PRIVATE_URL_FETCH=false
